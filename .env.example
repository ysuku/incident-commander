# Copy to .env (never commit .env). The agent runs without a key using extractive summaries.

# OpenRouter (course-recommended; OpenAI-compatible API)
OPENAI_API_KEY=            # your OpenRouter key: https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=              # any model id from https://openrouter.ai/models (free ones end in ":free")
IC_MAX_TOKENS=
# To use OpenAI directly instead, set OPENAI_BASE_URL=https://api.openai.com/v1 and an OpenAI model id.

# Anthropic API (used when --model is a claude-* id, e.g. --model claude-opus-5-5)
# Project-only name on purpose: never put a Claude key in your shell as ANTHROPIC_API_KEY
# (other tools, e.g. Claude Code, pick that up and bill it). This one is read from this
# file only, by the capstone's Claude client, and a shell ANTHROPIC_API_KEY is ignored.
IC_ANTHROPIC_API_KEY=      # https://console.anthropic.com/settings/keys
IC_EFFORT=medium           # low | medium | high | xhigh | max (thinking depth / spend)
IC_CLAUDE_MAX_TOKENS=16000
